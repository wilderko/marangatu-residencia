# ~/.config/marangatu/residencia.conf
# Konfigurácia pre marangatu_residencia.py (chmod 600!)
# Prihlasovacie údaje ostávajú v ~/.config/marangatu/credentials (USUARIO=, PASSWORD=)

# --- prehliadač -----------------------------------------------------------
# Engine, cez ktorý sa portál ovláda (Playwright). Default chromium (Blink).
# firefox (Gecko) je dobrovoľná alternatíva — treba doinštalovať:
#   venv/bin/playwright install firefox
# Prebiť sa dá aj ad hoc prepínačom: --browser firefox
BROWSER=chromium

# --- e-mail reporty --------------------------------------------------------
# Kam poslať report po každom behu (screenshoty + boleta v prílohe).
# Prázdne = e-mail sa neposiela (report ostáva v logu).
MAIL_TO=you@example.com
# Odosielateľ — použi adresu, ktorej doména má v SPF zázname IP tvojho servera,
# inak reporty skončia v spame
MAIL_FROM=Marangatu bot <bot@example.com>
SENDMAIL=/usr/sbin/sendmail

# --- suma faktúry ---------------------------------------------------------
# Manuál: fakturuj "niečo nad minimálnou mzdou". Prah sa porovnáva s bázou
# (casilla 10 Form 120 = príjem, ktorý vidí DNM). Minimálna mzda 2026:
MIN_INCOME_GS=3044000
# Doplnkové minimum v USD — skript berie VYŠŠIE z oboch (0 = nepoužiť)
MIN_INCOME_USD=600
# Rezerva navrch — faktúra sa vystaví o 10 % vyššia (aj kvôli pohybu kurzu)
SAFETY_MARGIN=1.10
# Pevný kurz Gs/USD. Ak necháš prázdne, stiahne sa aktuálny z open.er-api.com
FX_RATE_PYG=
# Záložný kurz, keď API nejde
FX_RATE_FALLBACK=6000
# S defaultmi a kurzom ~5 990: faktúra 3 960 000 Gs = báza 3 600 000 + IVA 360 000

# --- imputácia: krok Obligaciones (krok 3 manuálu) -------------------------
# Na zeleno sa prepnú LEN tieto povinnosti (čiarkou oddelené), ostatné na
# červeno. Bežné RUC pre pobyt má len IVA General. IRP-RSP pridaj iba ak na
# neho RUC naozaj je registrované (povinné nad 80 000 000 Gs/rok), napr.:
#   IMPUTAR_OBLIGACIONES=IVA GENERAL,IRP - RSP
IMPUTAR_OBLIGACIONES=IVA GENERAL

# --- termín podania a platby (krok 4 manuálu) ------------------------------
# Termín = deň podľa poslednej číslice RUC pred pomlčkou (0→7., 1→9., … 9→25.),
# víkend/sviatok → ďalší pracovný deň. Prázdne = odvodí sa z USUARIO
# (pri fyzickej osobe je RUC = číslo cédula).
RUC=
# Presunuté sviatky (1. 3., 12. 6., 29. 9. sa presúvajú) a iné dni voľna,
# ktoré skript nepozná — YYYY-MM-DD oddelené čiarkou
HOLIDAYS=

# --- Rubro 2 Form 120 (6-mesačný kumulatív) ---------------------------------
# Casilla 160 = súčet casilla 10 za posledných 6 období vrátane aktuálneho.
# Skript ich berie zo svojich záznamov; obdobie bez záznamu NEpočíta ako 0,
# kým mu to nepovieš:
# prvé obdobie, od ktorého máš IVA (staršie obdobia = 0), napr. 2026-07
RUC_START=
# obdobia podané mimo skriptu: YYYY-MM:báza(casilla 10), napr.
#   PRIOR_SALES_10=2026-05:0,2026-06:3600000
PRIOR_SALES_10=

# --- klient, ktorému sa fakturuje (krok 2 manuálu) ------------------------
# NO_DOMICILIADO = zahraničná osoba/firma bez paraguajského RUC (napr. LLC)
# CONTRIBUYENTE  = klient s paraguajským RUC
CLIENT_SITUACION=NO_DOMICILIADO

# pre CONTRIBUYENTE: RUC bez kontrolnej číslice za pomlčkou
CLIENT_RUC=

# pre NO_DOMICILIADO:
CLIENT_ID=EIN-XX-XXXXXXX          # pas alebo tax ID firmy
CLIENT_ID_TYPE=Identificación Tributaria   # alebo Pasaporte — text zo selectu
CLIENT_NAME=My Company LLC
CLIENT_ADDRESS=1234 Main St, Sheridan, WY 82801
CLIENT_COUNTRY=ESTADOS UNIDOS     # text zo selectu País
CLIENT_EMAIL=billing@example.com
CLIENT_PHONE=

# --- popis služby na faktúre ----------------------------------------------
SERVICE_DESCRIPTION=Servicios de consultoría informática
